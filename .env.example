# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push for the notice board (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
# Server-only (Vercel env vars; not needed for local dev):
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.vercel.app
SUPABASE_SERVICE_ROLE_KEY=
